class SearchIntelligenceLink(val topic: String) {
    val googleSearchUrl: String
    val googleNewsUrl: String

    init {
        // PowerShell's [System.Uri]::EscapeDataString uses RFC 3986 (space -> %20).
        // URLEncoder.encode uses application/x-www-form-urlencoded (space -> '+').
        // Replace '+' with '%20' to match EscapeDataString behavior.
        val encoded = URLEncoder.encode(topic, "UTF-8").replace("+", "%20")
        googleSearchUrl = "https://www.google.com/search?q=$encoded"
        googleNewsUrl = "https://news.google.com/search?q=$encoded"
    }
}

