{
  "pages": [
    "pages/index/index",
    "pages/logs/logs",
    "pages/profile/profile"
  ],
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#000000",
    "navigationBarTitleText": "CL40 World Global Architecture",
    "navigationBarTextStyle": "white"
  },
  "tabBar": {
    "color": "#7A7E83",
    "selectedColor": "#FF0000",
    "borderStyle": "black",
    "backgroundColor": "#ffffff",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "Home"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "Profile"
      }
    ]
  },
  "networkTimeout": {
    "request": 5000,
    "downloadFile": 5000
  },
  "style": "v2",
  "expo": {
    "name": "CL40 World Platform",
    "slug": "cl40-world-platform",
    "ios": {
      "bundleIdentifier": "world.cl40.global.clip",
      "associatedDomains": [
        "appclips.cl40.world"
      ]
    },
    "android": {
      "package": "world.cl40.global.instant",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": {
            "scheme": "https",
            "host": "cl40.world",
            "pathPrefix": "/instant"
          }
        }
      ]
    }
  }
}
